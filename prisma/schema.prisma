// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:/app/data/app.db?timeout=10000"
}

model Order {
  id          String   @id @default(uuid())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  orderHash   String
  expiresAt   DateTime
  offerPrice  String
  identifier  String
  taskId      String
  marketplace String
  slug        String

  @@index([taskId])           // Index on taskId
  @@index([marketplace])      // Index on marketplace
  @@index([taskId, marketplace]) // Composite index for filtering by both
}

model Wallet {
  id               String  @id @default(uuid())
  address          String  @unique
  openseaApproval Boolean @default(false)
  magicedenApproval Boolean @default(false)
  currency String

  @@index([address])
}