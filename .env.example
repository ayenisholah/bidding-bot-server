NODE_ENV="development"
# MongoDB URI - MUST include replicaSet parameter for transaction support
# For local development: mongodb://localhost:27017/BIDDING_BOT?replicaSet=rs0
# For Docker: mongodb://mongodb:27017/BIDDING_BOT?replicaSet=rs0
MONGODB_URI="mongodb://localhost:27017/BIDDING_BOT?replicaSet=rs0"

# MongoDB Connection Pool Configuration
# Increase these values for high-concurrency environments (100+ concurrent jobs)
MONGO_MAX_POOL_SIZE=100
MONGO_MIN_POOL_SIZE=30

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
ALCHEMY_API_KEY=your-alchemy-api-key
RATE_LIMIT=100
# For SQLite (old):

# For PostgreSQL (new - use this for better performance):
DATABASE_URL="postgresql://bidding_bot:bidding_bot_password@localhost:5432/bidding_bot_db?schema=public"

# Encryption key for wallet private keys (generate with: openssl rand -hex 32)
ENCRYPTION_KEY=your-64-character-hex-key-here

# Better Stack Configuration
# Get your token from: https://logs.betterstack.com/team/<team>/sources
BETTER_STACK_TOKEN=v2FdezDQtWAaLJ6oXD8pQn1R

# Optional: Better Stack Source ID (if you want to organize logs by source)
BETTER_STACK_SOURCE_ID=your-source-id

# Security Configuration for Update Endpoint
# API_KEY is used to authenticate update requests - use a strong, unique key
# Example: Generate with: openssl rand -hex 32
API_KEY=your-secure-api-key-here

# Server IP for update service (REQUIRED)
# Only this IP will be allowed to trigger updates (in addition to API key)
SERVER_IP=your-server-ip

# Username for update checks
USERNAME=your-username
