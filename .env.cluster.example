# Redis Cluster Configuration (Development)
# Use this for local development with Docker Compose cluster setup

# For Development (3-node cluster)
REDIS_NODES='[{"host":"localhost","port":7000},{"host":"localhost","port":7001},{"host":"localhost","port":7002}]'

# For Docker internal networking (if server runs in container)
# REDIS_NODES='[{"host":"redis-node-1","port":7000},{"host":"redis-node-2","port":7001},{"host":"redis-node-3","port":7002}]'

# Single instance fallback (if REDIS_NODES not set, will use these)
# REDIS_HOST=localhost
# REDIS_PORT=6379

# Other required environment variables
RATE_LIMIT=64
NODE_ENV=development
