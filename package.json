{
	"name": "bidding-bot-server",
	"version": "1.0.0",
	"description": "",
	"main": "index.js",
	"scripts": {
		"build": "tsc",
		"start": "NODE_OPTIONS='--max-old-space-size=3072' node --expose-gc dist/src/index.js",
		"dev": "docker compose -f compose.dev.yaml up -d && nodemon",
		"ci": "npm install --frozen-lockfile",
		"dc:down": "docker compose down -v",
		"dc:destroy": "docker stop $(docker ps -aq) || true sleep 3 docker compose down --volumes --remove-orphans --timeout 15 && docker system prune -af --volumes",
		"test": "nodemon test.ts",
		"test:opensea-loops": "ts-node test-opensea-loops.ts",
		"test:opensea-trait-loops": "ts-node test-opensea-trait-loops.ts",
		"test:verify-fix": "ts-node verify-opensea-fix.ts",
		"timeout:logs": "node scripts/show-timeout-logs.js",
		"dc:build": "DOCKER_BUILDKIT=1 docker buildx build --platform linux/arm64,linux/amd64 --cache-from type=registry,ref=nfttools/bidding-bot-server-production:buildcache --cache-to type=registry,ref=nfttools/bidding-bot-server-production:buildcache,mode=max -t nfttools/bidding-bot-server-production:latest --push .",
		"dc:push": "docker push nfttools/bidding-bot-server-production:latest",
		"lint": "eslint 'src/**/*.{ts,tsx}'",
		"lint:fix": "eslint 'src/**/*.{ts,tsx}' --fix"
	},
	"keywords": [],
	"author": "",
	"license": "ISC",
	"devDependencies": {
		"@eslint/js": "9.29.0",
		"@types/body-parser": "1.19.6",
		"@types/cors": "2.8.19",
		"@types/express": "^4.17.21",
		"@types/node": "24.0.1",
		"@types/ws": "8.18.1",
		"@typescript-eslint/eslint-plugin": "8.34.0",
		"@typescript-eslint/parser": "8.34.0",
		"eslint": "9.29.0",
		"eslint-plugin-unused-imports": "^4.1.4",
		"nodemon": "3.1.10",
		"ts-node": "^10.9.2",
		"tsconfig-paths": "^4.2.0",
		"typescript": "5.8.3"
	},
	"dependencies": {
		"@types/papaparse": "5.3.16",
		"axios": "^1.9.0",
		"axios-retry": "^4.5.0",
		"body-parser": "2.2.0",
		"bottleneck": "^2.19.5",
		"bullmq": "5.53.3",
		"bullmq-otel": "^1.0.1",
		"cors": "^2.8.5",
		"date-fns": "^4.1.0",
		"dotenv": "16.5.0",
		"ethers": "6.14.4",
		"express": "^4.19.2",
		"glob": "^11.0.3",
		"helmet": "^8.1.0",
		"ioredis": "5.6.1",
		"json-stable-stringify": "^1.3.0",
		"mongoose": "8.15.2",
		"p-queue": "^6.6.2",
		"papaparse": "5.5.3",
		"uuid": "^11.1.0",
		"ws": "8.18.2",
		"zod": "3.25.64"
	}
}
