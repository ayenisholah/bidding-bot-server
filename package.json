{
	"name": "server",
	"version": "1.0.0",
	"description": "",
	"main": "index.js",
	"scripts": {
		"build": "rm -rf prisma/migrations && rm -f prisma/dev.db && npx prisma migrate dev --name init && npx prisma generate && tsc",
		"dev:start": "docker compose -f compose.redis.yaml up -d && tsc && node --expose-gc dist/src/index.js",
		"start": "npx prisma migrate deploy && node --expose-gc dist/src/index.js",
		"dev": "docker compose -f compose.redis.yaml up -d && rm -rf prisma/migrations && rm -f prisma/dev.db && npx prisma migrate dev --name orders && nodemon",
		"ci": "npm install --frozen-lockfile",
		"dc:down": "docker compose down -v",
		"dc:destroy": "docker stop $(docker ps -aq) || true sleep 3 docker compose down --volumes --remove-orphans --timeout 15 && docker system prune -af --volumes",
		"test": "nodemon test.ts",
		"dc:start": "docker compose up --build",
		"dc:build": "DOCKER_BUILDKIT=1 docker buildx build --platform linux/arm64,linux/amd64 --cache-from type=registry,ref=ayenisholah/bidding-bot-server-production:buildcache --cache-to type=registry,ref=ayenisholah/bidding-bot-server-production:buildcache,mode=max -t ayenisholah/bidding-bot-server-production:latest --push .",
		"dc:push": "docker push ayenisholah/bidding-bot-server-production:latest"
	},
	"keywords": [],
	"author": "",
	"license": "ISC",
	"devDependencies": {
		"@types/body-parser": "^1.19.5",
		"@types/cors": "^2.8.17",
		"@types/express": "^4.17.21",
		"@types/node": "^22.5.1",
		"@types/ws": "^8.5.12",
		"nodemon": "^3.1.4",
		"ts-node": "^10.9.2",
		"tsconfig-paths": "^4.2.0",
		"typescript": "^5.5.4"
	},
	"dependencies": {
		"@prisma/client": "^6.5.0",
		"@types/papaparse": "^5.3.15",
		"async-mutex": "^0.5.0",
		"axios": "^1.7.7",
		"axios-retry": "^4.5.0",
		"body-parser": "^1.20.2",
		"bottleneck": "^2.19.5",
		"bullmq": "^5.13.0",
		"bullmq-otel": "^1.0.1",
		"colors": "^1.4.0",
		"cors": "^2.8.5",
		"dotenv": "^16.4.5",
		"ethers": "^5.7.2",
		"express": "^4.19.2",
		"ioredis": "^5.4.1",
		"json-stable-stringify": "^1.3.0",
		"mongoose": "^8.6.2",
		"p-queue": "^6.6.2",
		"papaparse": "^5.4.1",
		"prisma": "^6.5.0",
		"uuid": "^11.1.0",
		"ws": "^8.18.0",
		"zod": "^3.23.8"
	}
}
