# Redis configuration for 3-node cluster
REDIS_NODES='[{"host":"redis-node-1","port":6379},{"host":"redis-node-2","port":6379},{"host":"redis-node-3","port":6379}]'

# Copy other environment variables from your .env file
PORT=3003
MONGODB_URI=mongodb://localhost:27017/BIDDING_BOT
ALCHEMY_API_KEY=your-key-here

# Performance optimizations
BROADCAST_INTERVAL=5000
VALIDATE_BID_INTERVAL=30000
MIN_LOOP_DELAY=100
BATCH_SIZE=10